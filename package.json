{
  "name": "3dgs-scene-lab",
  "private": true,
  "scripts": {
    "build": "npm run build:main && npm run build:vendor:playcanvas && npm run build:vendor:three-r186",
    "build:main": "esbuild viewer.js --bundle --minify --alias:three/addons/postprocessing/Pass.js=./vendor/three/examples/jsm/postprocessing/Pass.js --alias:three=./vendor/three/three.module.js --external:node:worker_threads --format=iife --platform=browser --target=es2020 --outfile=viewer.bundle.js",
    "build:vendor:playcanvas": "esbuild viewer-vendor-playcanvas.mjs --bundle --minify --external:node:worker_threads --format=iife --platform=browser --target=es2020 --outfile=viewer-vendor-playcanvas.bundle.js",
    "build:vendor:three-r186": "node tools/build-three-r186.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build && node --check viewer.js && htmlhint index.html",
    "dev": "http-server . -p 4173 -c-1 --cors",
    "open": "powershell -ExecutionPolicy Bypass -File .\\tools\\open_viewer.ps1 -Browser Auto",
    "open:chrome": "powershell -ExecutionPolicy Bypass -File .\\tools\\open_viewer.ps1 -Browser Chrome",
    "open:edge": "powershell -ExecutionPolicy Bypass -File .\\tools\\open_viewer.ps1 -Browser Edge"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "htmlhint": "^1.7.1",
    "http-server": "^14.1.1",
    "playwright-core": "^1.59.1"
  },
  "dependencies": {
    "playcanvas": "2.22.0",
    "three-r186": "npm:three@0.186.0"
  }
}
